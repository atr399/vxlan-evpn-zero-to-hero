terminal length 0
terminal dont-ask
configure terminal
hostname leaf2
feature ospf
feature bgp
feature nv overlay
nv overlay evpn
feature interface-vlan
feature vn-segment-vlan-based
feature vpc
feature lacp
fabric forwarding anycast-gateway-mac 0000.2222.3333
route-map ALL_ROUTES permit 10
vlan 10
  name TenantA-Web
  vn-segment 10010
vlan 20
  name TenantA-App
  vn-segment 10020
vlan 30
  name TenantB-Web
  vn-segment 10030
vlan 40
  name TenantB-App
  vn-segment 10040
