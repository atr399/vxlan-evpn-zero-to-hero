nv overlay evpn
feature interface-vlan
feature vn-segment-vlan-based
feature vpc
feature lacp
fabric forwarding anycast-gateway-mac 0000.2222.3333
route-map ALL_ROUTES permit 10
vlan 10
  name TenantA-Web
  vn-segment 10010
vlan 20
  name TenantA-App
  vn-segment 10020
vlan 30
  name TenantB-Web
  vn-segment 10030
vlan 40
  name TenantB-App
  vn-segment 10040
vlan 50
  name TenantA-L2Out
  vn-segment 10050
vlan 99
  name L3VNI-TenantA
  vn-segment 50001
vlan 98
  name L3VNI-TenantB
  vn-segment 50002
vrf context Tenant-A
  vni 50001
  rd auto
  address-family ipv4 unicast
    route-target both auto
    route-target both auto evpn
    route-target import 65000:50002
    route-target import 65000:50002 evpn
vrf context Tenant-B
  vni 50002
  rd auto
  address-family ipv4 unicast
    route-target both auto
    route-target both auto evpn
    route-target import 65000:50001
    route-target import 65000:50001 evpn
vpc domain 10
  peer-switch
  role priority 2
  peer-keepalive destination 10.20.0.0 source 10.20.0.1 vrf default
  delay restore 150
  peer-gateway
  ipv6 nd synchronize
  ip arp synchronize
interface loopback0
  description Router-ID and OSPF source
  ip address 10.0.0.22/32
  ip router ospf UNDERLAY area 0.0.0.0
interface loopback1
  description VTEP NVE source
  ip address 10.0.1.22/32
  ip address 10.0.1.100/32 secondary
  ip router ospf UNDERLAY area 0.0.0.0
interface Vlan10
