  no shutdown
  vrf member Tenant-B
  ip address 10.200.10.1/24
  fabric forwarding mode anycast-gateway
interface Vlan40
  description Tenant-B VLAN 40 anycast gateway
  no shutdown
  vrf member Tenant-B
  ip address 10.200.20.1/24
  fabric forwarding mode anycast-gateway
interface Vlan99
  description L3VNI carrier for Tenant-A
  no shutdown
  vrf member Tenant-A
  ip forward
  no ip redirects
interface Vlan98
  description L3VNI carrier for Tenant-B
  no shutdown
  vrf member Tenant-B
  ip forward
  no ip redirects
interface port-channel100
  description vPC peer-link
  switchport
  switchport mode trunk
  switchport trunk allowed vlan 1,10,20,30,40,50,98,99
  spanning-tree port type network
  vpc peer-link
interface Ethernet1/4
  description vPC peer-link member
  switchport
  switchport mode trunk
  switchport trunk allowed vlan 1,10,20,30,40,50,98,99
  channel-group 100 mode active
  no shutdown
interface Ethernet1/5
  description vPC peer-keepalive link
  no switchport
  mtu 1500
  no shutdown
  ip address 10.20.0.1/31
interface Ethernet1/1
  description to spine1 Eth1/2
  no switchport
  mtu 9216
  no shutdown
  ip address 10.10.2.1/31
  ip ospf network point-to-point
  ip router ospf UNDERLAY area 0.0.0.0
interface Ethernet1/2
  description to spine2 Eth1/2
  no switchport
  mtu 9216
  no shutdown
  ip address 10.10.4.1/31
  ip ospf network point-to-point
  ip router ospf UNDERLAY area 0.0.0.0
interface Ethernet1/3
  description to host2 (VLAN 30)
  switchport
  switchport mode access
  switchport access vlan 30
  no shutdown
interface Ethernet1/6
  description to host1 bond (vPC 10 member, second leg)
  switchport
  switchport mode trunk
  switchport trunk native vlan 10
  switchport trunk allowed vlan 10
  channel-group 10 mode active
  no shutdown
interface port-channel10
