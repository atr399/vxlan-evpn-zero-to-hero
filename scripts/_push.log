  ip forward
  no ip redirects
interface Vlan98
  description L3VNI carrier for Tenant-B
  no shutdown
  vrf member Tenant-B
  ip forward
  no ip redirects
interface port-channel100
  description vPC peer-link
  switchport
  switchport mode trunk
  switchport trunk allowed vlan 1,10,20,30,40,50,98,99
  spanning-tree port type network
  vpc peer-link
interface Ethernet1/4
  description vPC peer-link member
  switchport
  switchport mode trunk
  switchport trunk allowed vlan 1,10,20,30,40,50,98,99
  channel-group 100 mode active
  no shutdown
interface Ethernet1/5
  description vPC peer-keepalive link
  no switchport
  mtu 1500
  no shutdown
  ip address 10.20.0.1/31
interface Ethernet1/1
  description to spine1 Eth1/2
  no switchport
  mtu 9216
  no shutdown
