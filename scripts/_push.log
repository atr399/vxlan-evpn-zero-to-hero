  ip address 10.100.10.1/24
  fabric forwarding mode anycast-gateway
interface Vlan20
  description Tenant-A VLAN 20 anycast gateway
  no shutdown
  vrf member Tenant-A
  ip address 10.100.20.1/24
  fabric forwarding mode anycast-gateway
interface Vlan30
  description Tenant-B VLAN 30 anycast gateway
  no shutdown
  vrf member Tenant-B
  ip address 10.200.10.1/24
  fabric forwarding mode anycast-gateway
interface Vlan40
  description Tenant-B VLAN 40 anycast gateway
  no shutdown
  vrf member Tenant-B
  ip address 10.200.20.1/24
  fabric forwarding mode anycast-gateway
interface Vlan99
  description L3VNI carrier for Tenant-A
  no shutdown
  vrf member Tenant-A
  ip forward
  no ip redirects
interface Vlan98
  description L3VNI carrier for Tenant-B
  no shutdown
  vrf member Tenant-B
  ip forward
  no ip redirects
interface Ethernet1/1
  description to spine1 Eth1/1
  no switchport
  mtu 9216
  no shutdown
  ip address 10.10.1.1/31
  ip ospf network point-to-point
  ip router ospf UNDERLAY area 0.0.0.0
interface Ethernet1/2
  description to spine2 Eth1/1
  no switchport
  mtu 9216
  no shutdown
  ip address 10.10.3.1/31
  ip ospf network point-to-point
  ip router ospf UNDERLAY area 0.0.0.0
interface Ethernet1/3
  description to host1 (VLAN 10)
  switchport
  switchport mode access
  switchport access vlan 10
  no shutdown
interface nve1
  description VXLAN tunnel endpoint
  no shutdown
  host-reachability protocol bgp
  source-interface loopback1
  member vni 10010
    ingress-replication protocol bgp
  member vni 10020
    ingress-replication protocol bgp
  member vni 10030
    ingress-replication protocol bgp
  member vni 10040
    ingress-replication protocol bgp
  member vni 50001 associate-vrf
  member vni 50002 associate-vrf
router ospf UNDERLAY
  router-id 10.0.0.21
router bgp 65000
  router-id 10.0.0.21
  address-family l2vpn evpn
