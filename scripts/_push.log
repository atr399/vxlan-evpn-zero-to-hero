vlan 98
  name L3VNI-TenantB
  vn-segment 50002
vrf context Tenant-A
  vni 50001
  rd auto
  address-family ipv4 unicast
    route-target both auto
    route-target both auto evpn
    route-target import 65000:50002
    route-target import 65000:50002 evpn
vrf context Tenant-B
  vni 50002
  rd auto
  address-family ipv4 unicast
    route-target both auto
    route-target both auto evpn
    route-target import 65000:50001
    route-target import 65000:50001 evpn
vpc domain 10
  peer-switch
  role priority 2
  peer-keepalive destination 10.20.0.0 source 10.20.0.1 vrf default
  delay restore 150
  peer-gateway
  ipv6 nd synchronize
  ip arp synchronize
interface loopback0
  description Router-ID and OSPF source
  ip address 10.0.0.22/32
  ip router ospf UNDERLAY area 0.0.0.0
interface loopback1
  description VTEP NVE source
  ip address 10.0.1.22/32
  ip address 10.0.1.100/32 secondary
  ip router ospf UNDERLAY area 0.0.0.0
interface Vlan10
  description Tenant-A VLAN 10 anycast gateway
  no shutdown
  vrf member Tenant-A
  ip address 10.100.10.1/24
  fabric forwarding mode anycast-gateway
interface Vlan20
  description Tenant-A VLAN 20 anycast gateway
  no shutdown
  vrf member Tenant-A
  ip address 10.100.20.1/24
  fabric forwarding mode anycast-gateway
interface Vlan50
  description Tenant-A VLAN 50 anycast gateway (L2Out)
